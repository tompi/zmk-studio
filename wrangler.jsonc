// Cloudflare Workers config: serves the built web app (npm run build) as static files
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zmk-studio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serves /download from download.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
